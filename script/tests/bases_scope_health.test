#!/usr/bin/env bash
# Public health-check seam: independent checkouts are excluded, active code is not.
set -euo pipefail
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
tmp="$(mktemp -d)"
trap 'rm -rf -- "$tmp"' EXIT
mkdir -p "$tmp/script" "$tmp/.worktrees/worker"
cp "$root/script/check_cpst_paths.sh" "$root/script/check_tracked.sh" "$tmp/script/"
for step in util 01_data_raw 02_gene_axis 03_data_train 04_tsg_axis 05_tsg_loss 05_tsg_loss/{05.1_loss_metrics,05.2_mse_l1,05.3_mse-l1_mse-x,05.4_mse-l1_pcc,05.5_mse-l1_cos} 06_tsg_module 06_tsg_module/{06.1_round1,06.2_round2,06.3_round3,06.4_round4} 07_cpst_loss 08_cpst_chem-emb 09_cpst_axis 10_cpst_dose; do
  mkdir -p "$tmp/cpst/$step"
  printf '%s\n' "$step" > "$tmp/cpst/$step/AGENTS.md"
  printf '%s\n' "$step" > "$tmp/cpst/$step/README.md"
done
printf 'x = 1\n' > "$tmp/cpst/01_data_raw/run.py"
printf 'x = 1\n' > "$tmp/cpst/04_tsg_axis/run.py"
printf 'x = 1\n' > "$tmp/.worktrees/worker/run.py"
printf 'Stage 2\n' >"$tmp/cpst/AGENTS.md"
printf 'Stage 2\n' >"$tmp/cpst/README.md"
printf '/cpst/history/\n' >"$tmp/.gitignore"
git -C "$tmp" init -q
git -C "$tmp" add script cpst .gitignore
bash "$tmp/script/check_cpst_paths.sh" >/dev/null
bash "$tmp/script/check_tracked.sh" >/dev/null
mkdir "$tmp/cpst/history"
if bash "$tmp/script/check_cpst_paths.sh" >/dev/null 2>&1; then
  echo 'FAIL: retired Stage 2 history must fail' >&2; exit 1
fi
rmdir "$tmp/cpst/history"
mkdir "$tmp/cpst/evaluation"
if bash "$tmp/script/check_cpst_paths.sh" >/dev/null 2>&1; then
  echo 'FAIL: an extra Stage 2 entry must fail' >&2; exit 1
fi
rmdir "$tmp/cpst/evaluation"
printf 'x = 1\n' > "$tmp/cpst/01_data_raw/untracked.py"
if bash "$tmp/script/check_tracked.sh" >/dev/null 2>&1; then
  echo 'FAIL: active untracked executable must fail' >&2; exit 1
fi
mkdir -p "$tmp/cpst/03_data_train/fixture/history"
printf 'x = 1\n' >"$tmp/cpst/03_data_train/fixture/history/worker.py"
rm "$tmp/cpst/01_data_raw/untracked.py"
if bash "$tmp/script/check_tracked.sh" >/dev/null 2>&1; then
  echo 'FAIL: an unrelated history directory must still be audited' >&2; exit 1
fi
echo 'PASS: active-roots layout and separate-checkout tracking boundaries'
