#!/usr/bin/env python3
"""Public inventory guard regression; tiny offline inventory, no large hashes."""
import json
import pathlib
import shutil
import subprocess
import tempfile

ROOT = pathlib.Path(__file__).resolve().parents[2]
with tempfile.TemporaryDirectory() as tmp:
    root = pathlib.Path(tmp)
    (root / '.git').mkdir()
    (root / 'script').mkdir()
    shutil.copy(ROOT / 'script/verify_all.sh', root / 'script/verify_all.sh')
    for item in ('Annotation DToxS-iPSC GSE244740 GSE247541 GSE262419 LINCS-LDS-1593 Tahoe-100M XPert-L1000').split():
        (root / 'pert_data' / item / 'script').mkdir(parents=True)
    for category, names in [('pert_model', 'PRnet CPA chemCPA biolord PerturbNet scVIDR Squidiff CMonge DECANT WAVE ExPO State TranSiGen XPert'), ('disease_data', 'GSE108940 GSE137293 GSE160516'), ('drug_emb_model', 'HG KPGT')]:
        for item in names.split():
            (root / category / item / 'script').mkdir(parents=True)
    for directory in root.glob('*/*/script'):
        (directory / 'verify.sh').write_text('exit 0\n')
        (directory.parent / 'manifest.sha256').write_text('fixture\n')
    def check(expected):
        result = subprocess.run(['bash', str(root / 'script/verify_all.sh')], capture_output=True, text=True)
        assert result.returncode == expected, result.stdout + result.stderr
    check(1)  # fifth category must be mandatory
    (root / 'pheno_data').mkdir()
    (root / 'pheno_data/registry.json').write_text(json.dumps({'schema_version': 1, 'items': [{'item': 'Sirenko-2013', 'dataset_id': 'sirenko_2013', 'status': 'active'}]}))
    check(1)  # active item absent
    source = root / 'pheno_data/Sirenko-2013'
    (source / 'script').mkdir(parents=True)
    (source / 'script/verify.sh').write_text('exit 0\n')
    (source / 'manifest.sha256').write_text('fixture\n')
    check(0)
    (source / 'manifest.sha256').write_text('')
    check(1)
    (source / 'manifest.sha256').write_text('fixture\n')
    (source / 'script/verify.sh').unlink()
    check(1)
    (source / 'script/verify.sh').write_text('exit 0\n')
    (root / 'pheno_data/Unknown').mkdir()
    check(1)
print('PASS: fifth-category inventory fails closed')
