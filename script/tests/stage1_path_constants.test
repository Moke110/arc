#!/usr/bin/env bash
# A materialized Stage 1 checkout validates its frozen inputs without sibling workflows.
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
cd -- "$repo_root"

if [[ ! -e stage1 && ! -L stage1 ]]; then
  echo 'SKIP: the local Stage 1 predecessor is absent'
  exit 0
fi

test -f stage1/screen.ipynb
test -f stage1/03_cm_finetune_data/output/cm_union.h5ad
while IFS=$'\t' read -r path target; do
  if [[ ! -L "stage1/$path" || $(readlink "stage1/$path") != "$target" || ! -f "stage1/$path" ]]; then
    echo "missing or changed Stage 1 weight symlink: $path" >&2
    exit 1
  fi
done <stage1/pre_cutover_weights.tsv

(cd stage1/input/references && sha256sum -c manifest.sha256)
bash pert_data/Annotation/script/verify_audit_seed.sh

for version in v0 v1 v1.1 v2 v3; do
  if [[ -e "stage1/xpert-fda-miri-$version" || -L "stage1/xpert-fda-miri-$version" ]]; then
    echo "legacy Stage 1 workflow remains: xpert-fda-miri-$version" >&2
    exit 1
  fi
done

echo "PASS: Stage 1 uses its own frozen inputs and Annotation owns the offline audit seed"
