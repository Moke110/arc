#!/usr/bin/env python3
"""Real frozen Sirenko CLI regression, offline; acquire originals before running."""
from pathlib import Path
import shutil
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parents[2]
with tempfile.TemporaryDirectory() as tmp:
    root = Path(tmp)
    (root/'.git').mkdir()
    (root/'script').mkdir()
    shutil.copy(ROOT/'script/phenotype_archive.py', root/'script/phenotype_archive.py')
    item = root/'pheno_data/Sirenko-2013'
    shutil.copytree(ROOT/'pheno_data/Sirenko-2013', item)
    command = ['python3', str(item/'script/download.py'), '--verify']
    def check(expected):
        result = subprocess.run(command, capture_output=True, text=True)
        assert (result.returncode == 0) == expected, result.stdout + result.stderr
    check(True)
    original = (item/'source/publisher-mmc3.xls').read_bytes()
    (item/'source/publisher-mmc3.xls').write_bytes(original + b'corrupt')
    check(False)
    (item/'source/publisher-mmc3.xls').write_bytes(original)
    (item/'source/metadata.json').unlink()
    check(False)
print('PASS: real frozen source CLI rejects hash mismatch and missing original')

# The acquisition verifier also has a public API used by item CLI wrappers.
# Small explicit fixtures exercise HTML identity and local-addition provenance.
import hashlib
import json
import sys
sys.path.insert(0, str(ROOT/'script'))
from phenotype_archive import verify
with tempfile.TemporaryDirectory() as tmp:
    item = Path(tmp)
    (item/'source').mkdir()
    assets = {'article.html': 'https://example.invalid/article'}
    markers = {'article.html': ['citation_doi', '10.1234/test', 'Expected title']}
    def freeze(html):
        raw = html.encode()
        (item/'source/article.html').write_bytes(raw)
        digest = hashlib.sha256(raw).hexdigest()
        (item/'manifest.sha256').write_text(digest+'  article.html\n')
        (item/'author_log.json').write_text(json.dumps({'dataset_id':'test_archive','sources':[{'path':'article.html','url':assets['article.html'],'sha256':digest,'bytes':len(raw)}],'validation':{'expected_html_markers':markers},'local_additions':[]}))
    freeze('<html><meta name="citation_doi" content="10.1234/test"><title>Expected title</title></html>')
    verify(item, 'test_archive', 'PMC0', assets)
    freeze('<html><title>Preparing to download</title>citation_doi 10.1234/test Expected title</html>')
    try:
        verify(item, 'test_archive', 'PMC0', assets)
    except ValueError:
        pass
    else:
        raise AssertionError('HTML preparation page accepted')
    freeze('<html><title>Wrong article</title></html>')
    try:
        verify(item, 'test_archive', 'PMC0', assets)
    except ValueError:
        pass
    else:
        raise AssertionError('wrong article accepted')
print('PASS: HTML article identity and challenge rejection')
