#!/usr/bin/env bash
# Regression (#17): script/check_stage2_paths.sh detects retired stage2 paths.
#
# Runs the audit against fixture files (via the STAGE2_PATH_AUDIT_FILES test
# hook, so the tracked tree is never dirtied) and against the real tracked tree.
# Positive, negative and frozen-exemption cases are all exercised.

set -uo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
audit="$repo_root/script/check_stage2_paths.sh"
tmp="$(mktemp -d)"
trap 'rm -rf -- "${tmp:-}"' EXIT

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

run() {
  STAGE2_PATH_AUDIT_FILES="$1" bash "$audit"
}

# 1. Fixture scans exercise runtime literals independently of the checkout layout.
# 2. Positive: clean fixture.
printf 'x = 1\n' >"$tmp/clean.py"
printf '%s\n' "$tmp/clean.py" >"$tmp/list_clean"
out="$(run "$tmp/list_clean")" || fail "a clean fixture should pass"
printf '%s\n' "$out" | grep -q '^stale: 0 occurrences' \
  || fail "clean fixture did not report stale: 0"

# 3. Negative: a retired 02_cm_data literal is reported and fails.
printf 'SOURCE = "stage2/02_cm_data/output/corpus/v1/genes.csv"\n' >"$tmp/stale02.py"
printf '%s\n' "$tmp/stale02.py" >"$tmp/list_stale02"
if out="$(run "$tmp/list_stale02")"; then
  fail "a stage2/02_cm_data literal must fail the audit"
fi
printf '%s\n' "$out" | grep -q '^stale: 1 occurrences' \
  || fail "stale literal was not counted"
printf '%s\n' "$out" | grep -q 'stage2/02_cm_data/output/corpus/v1/genes.csv' \
  || fail "stale literal was not printed"

# 4. Negative: a retired 04_tahoe_data literal fails.
printf 'p = "stage2/04_tahoe_data/output/pseudobulk"\n' >"$tmp/stale04.py"
printf '%s\n' "$tmp/stale04.py" >"$tmp/list_stale04"
if run "$tmp/list_stale04" >/dev/null; then
  fail "a stage2/04_tahoe_data literal must fail the audit"
fi

# 5. Negative: a bare `datasets-1` path component fails.
printf 'p = "stage2/03_models_cmbench/datasets-1/x.h5ad"\n' >"$tmp/bare.py"
printf '%s\n' "$tmp/bare.py" >"$tmp/list_bare"
if run "$tmp/list_bare" >/dev/null; then
  fail "a non-frozen datasets-1 path must fail the audit"
fi

# 6. A deleted frozen runtime is no longer an implicit exemption.
printf 'p = "stage2/_frozen/cm-data-v1/datasets-1/x.h5ad"\n' >"$tmp/frozen.py"
printf '%s\n' "$tmp/frozen.py" >"$tmp/list_frozen"
if run "$tmp/list_frozen" >/dev/null; then fail "deleted frozen runtime must fail"; fi

# Newly retired runtime roots fail; current bases and immutable sources pass.
for old in 02_dataset_corpus evaluation 09_xpert_optimize _frozen; do
  printf 'p = "stage2/%s/output/x"\n' "$old" >"$tmp/new_stale.py"
  printf '%s\n' "$tmp/new_stale.py" >"$tmp/list_new"
  if run "$tmp/list_new" >/dev/null; then fail "$old runtime path must fail"; fi
done
printf 'p = "stage2/01_bases/output/x"\nq = "stage2/02_models_tenv/output/x"\nr = "stage2/02_models_tenv-5k/output/x"\n' >"$tmp/current.py"
printf '%s\n' "$tmp/current.py" >"$tmp/list_current"
run "$tmp/list_current" >/dev/null || fail "active roots/external source must pass"
# An active-root prefix must not exempt a longer retired-looking sibling name.
for sibling in 02_models_tenv_extra 02_models_tenv-5k_extra; do
  printf 'p = "stage2/%s/output/x"\n' "$sibling" >"$tmp/prefix.py"
  printf '%s\n' "$tmp/prefix.py" >"$tmp/list_prefix"
  if run "$tmp/list_prefix" >/dev/null; then
    fail "a $sibling literal must fail the audit"
  fi
done

# 7. Layout guard (#157 review S2): a stray regular file at the Stage 2 root
#    must fail, while the routing document stage2/AGENTS.md must pass.  The
#    guard runs in fixture mode too, so a throwaway root can exercise both
#    directions without touching the checkout.
run_root() {
  STAGE2_PATH_AUDIT_ROOT="$1" STAGE2_PATH_AUDIT_FILES="$2" bash "$audit"
}
fixture_root="$tmp/layout/stage2"
mkdir -p "$fixture_root/01_bases" "$fixture_root/02_models_tenv" "$fixture_root/02_models_tenv-5k"
printf 'bases\n' >"$fixture_root/AGENTS.md"
printf 'bases\n' >"$fixture_root/01_bases/AGENTS.md"
printf 'bases\n' >"$fixture_root/01_bases/README.md"
printf 'models\n' >"$fixture_root/02_models_tenv/AGENTS.md"
printf 'models\n' >"$fixture_root/02_models_tenv/README.md"
printf 'successor\n' >"$fixture_root/02_models_tenv-5k/AGENTS.md"
printf 'successor\n' >"$fixture_root/02_models_tenv-5k/README.md"
run_root "$fixture_root" "$tmp/list_clean" >/dev/null \
  || fail "the accepted steps and approved successor must coexist with routing"
# A retired third root is still rejected.
mkdir -p "$fixture_root/03_modes_tenv"
if out="$(run_root "$fixture_root" "$tmp/list_clean" 2>&1)"; then
  fail "a retired 03_modes_tenv root must fail the layout guard"
fi
printf '%s\n' "$out" | grep -q 'unexpected Stage 2 entry: .*03_modes_tenv' \
  || fail "the retired root must be named in the failure"
rmdir "$fixture_root/03_modes_tenv"
# An active root without its routing skeleton is rejected.
mv "$fixture_root/02_models_tenv/README.md" "$tmp/README.off"
if out="$(run_root "$fixture_root" "$tmp/list_clean" 2>&1)"; then
  fail "an active step without README.md must fail the layout guard"
fi
printf '%s\n' "$out" | grep -q 'missing step routing: .*02_models_tenv/README.md' \
  || fail "the missing routing file must be named in the failure"
mv "$tmp/README.off" "$fixture_root/02_models_tenv/README.md"
mv "$fixture_root/02_models_tenv-5k/README.md" "$tmp/successor-README.off"
if out="$(run_root "$fixture_root" "$tmp/list_clean" 2>&1)"; then
  fail "the approved successor without README.md must fail the layout guard"
fi
printf '%s\n' "$out" | grep -q 'missing step routing: .*02_models_tenv-5k/README.md' \
  || fail "the missing successor routing file must be named in the failure"
mv "$tmp/successor-README.off" "$fixture_root/02_models_tenv-5k/README.md"
printf 'notes\n' >"$fixture_root/notes.md"
if out="$(run_root "$fixture_root" "$tmp/list_clean" 2>&1)"; then
  fail "a stray regular file at the Stage 2 root must fail the layout guard"
fi
printf '%s\n' "$out" | grep -q 'unexpected Stage 2 entry: .*notes.md' \
  || fail "the stray file must be named in the failure"
rm -f "$fixture_root/notes.md"
ln -s AGENTS.md "$fixture_root/link.md"
if run_root "$fixture_root" "$tmp/list_clean" >/dev/null; then
  fail "a symlink-to-file at the Stage 2 root must fail the layout guard"
fi
rm -f "$fixture_root/link.md"
# The real root carries the routing document and must keep passing.
run "$tmp/list_clean" >/dev/null || fail "the real stage2/AGENTS.md must pass"

echo "PASS: active-roots Stage 2 runtime path fixtures"
