  "generated_by": "stage2/01_bases/execution/build_disease_fusion.py",
  "limit": 2000,
  "rank_contract": "stage2-disease-deg-v2",
  "rank_semantics": "deg-only-v2",
  "schema": "stage2-disease-fusion-v1",
  "semantics": {
    "deg": "a gene is a DEG of a source when padj < 0.05 AND |log2FC| >= 2 in a declared contrast (ADR 0071 decision 1); each source ranks its DEGs 1..n_DEG by descending effect with a gene_index tie-break and gives every other frozen-axis gene n_DEG + 1",
    "deg2000": "the DEG-union genes whose disease rank is <= 2000 (the whole union when it is smaller); a DEG union occupies the first ranks, so |DEG2000| == min(|union|, 2000)",
    "deg_union": "the genes that are a DEG in at least one informative source; its size is not padded and not constrained to 2,000",
    "flag_derivation": "a published v2 table carries the pass-any-contrast deg flag (authoritative); a v1 table carries only the collapsed winning-contrast rows, so its v2 flag is re-derived from those rows and the ledger records flag_source = collapsed_winning_contrast",
    "level_one": "disease_rank_sum = sum over the disease informative sources of rank_norm = rank / n_DEG; the disease rank is the ascending position of that sum with a gene_index tie-break",
    "non_informative": "a source with n_DEG = 0 has no rank_norm (the ADR 0071 denominator is zero) and a source whose measured effects are all tied carries no ordering evidence; both are excluded from the sum and recorded with their reason (ADR 0068), so a NaN can never poison a disease sum",
    "tier_stop": "the tier-stop criterion is the disease DEG union resolved to the frozen 18,164-gene axis (axis-resolved, not genome-wide): a source DEG off the axis cannot enter DEG2000 or any axis built from it, so it does not count toward the 2,000-gene stop test. Sources are collected in ascending tier order; a tier with no declared source is absent from the ladder (AF declares tier 1 and tier 3, no tier 2), and a category whose evidence begins at tier 2 (the cardiotox classes) enters there. The cumulative axis-resolved union is measured after each tier and collection stops at the first tier whose union reaches the limit; a declared source in a deeper tier after a completed tier that already reached the limit is refused rather than admitted. Only declared sources are collected, so a tier between two entered tiers is never back-filled."
  }
