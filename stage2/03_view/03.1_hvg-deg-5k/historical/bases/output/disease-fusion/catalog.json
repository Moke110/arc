  "limit": 1000,
  "rank_contract": "stage2-disease-deg-v2",
  "rank_semantics": "deg-only-v2",
  "schema": "stage2-disease-fusion-tier-first-v2",
  "semantics": {
    "deg": "a gene is a DEG of a source when padj < 0.05 AND |log2FC| >= 2 in a declared contrast (ADR 0071 decision 1); each source ranks its DEGs 1..n_DEG by descending effect with a gene_index tie-break and gives every other frozen-axis gene n_DEG + 1",
    "deg1000": "the DEG-union genes whose disease rank is <= 1000 (the whole union when it is smaller); a DEG union occupies the first ranks, so |DEG1000| == min(|union|, 1000)",
    "deg_union": "the genes that are a DEG in at least one informative source; its size is not padded or constrained by the DEG1000 cutoff",
    "flag_derivation": "a published v2 table carries the pass-any-contrast deg flag (authoritative); a v1 table carries only the collapsed winning-contrast rows, so its v2 flag is re-derived from those rows and the ledger records flag_source = collapsed_winning_contrast",
    "level_one": "disease_rank_sum = sum over the disease informative sources of rank_norm = rank / n_DEG; the disease rank is the ascending position ordered by source_tier_highest, that sum and gene_index",
    "non_informative": "a source with n_DEG = 0 has no rank_norm (the ADR 0071 denominator is zero) and a source whose measured effects are all tied carries no ordering evidence; both are excluded from the sum and recorded with their reason (ADR 0068), so a NaN can never poison a disease sum",
    "source_collection": "Collect all qualifying declared sources in ascending tier order; measure the complete cumulative disease DEG union on the frozen axis (axis-resolved, not genome-wide) after each tier. No DEG-count stopping condition applies. Missing tiers are absent, never back-filled with invented sources.",
    "source_tier_highest": "minimum numeric tier over informative sources where the gene is DEG-positive; mere measurement gives no support"
  }
}
