{
  "model": "squidiff",
  "source": "pert_model/Squidiff/source (abdfc27d), BSD-3",
  "author_entrypoint": "train_squidiff.py / sample_squidiff.py",
  "gene_size": 18164,
  "output_dim": 18164,
  "num_layers": 3,
  "hidden_sizes": 2048,
  "time_embed_dim": 2048,
  "latent_dim": 60,
  "use_encoder": true,
  "use_drug_structure": true,
  "drug_dimension": 1024,
  "comb_num": 1,
  "class_cond": false,
  "diffusion_steps": 1000,
  "noise_schedule": "linear",
  "loss": "epsilon_mse",
  "sampling": "ddim",
  "fingerprint": {
    "kind": "morgan_features",
    "radius": 2,
    "n_bits": 1024,
    "dose_transform": "log10(dose_uM + 1)"
  },
  "optimizer": {
    "name": "adamw",
    "lr": 0.0001,
    "weight_decay": 0.0
  },
  "schedule": {
    "name": "linear_anneal_to_zero",
    "total_steps": 100000
  },
  "total_steps": 100000,
  "batch_size": 64,
  "ema_rate": 0.9999,
  "checkpoint_grid": 10,
  "checkpoint_grid_frac": 0.1,
  "valid_timesteps": 8,
  "seed": 20261021,
  "smoke": {
    "total_steps": 20,
    "sample_steps": 10,
    "valid_timesteps": 4
  },
  "notes": {
    "target_space": "log1p_cp10k (benchmark data contract)",
    "prediction": "DDIM sample of absolute expression, one draw per well, minus the matched plate DMSO mean",
    "control_policy": "one matched DMSO cell per well (Controls.cell_for on the well's plate/replicate); the corpus has no paired_control_index",
    "checkpoint_selection": "author epsilon-MSE on the cold valid drugs at the 10% grid, raw and EMA states; no early stopping",
    "early_stopping": "none (author fixed 100,000 steps)"
  }
}
