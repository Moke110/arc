# ADR 0082 view-variant study: manifests, parents, splits and CSV summaries are
# tracked evidence; expression payloads, frozen truth/run payloads and build or
# fit state are disposable and stay local to the checkout that produced them.
# The global `output/` rule hides the directory, so re-include it before the
# payload patterns below re-exclude the heavy files.
!/stage2/03_data_train/03.1_hvg-deg-5k/historical/tsg_view/figure/data/*.csv
!/stage2/03_data_train/03.1_hvg-deg-5k/historical/tsg_view/output/
!/stage2/03_data_train/03.1_hvg-deg-5k/historical/tsg_view/output/**
/stage2/03_data_train/03.1_hvg-deg-5k/historical/tsg_view/output/**/*.h5ad
/stage2/03_data_train/03.1_hvg-deg-5k/historical/tsg_view/output/**/*.npy
/stage2/03_data_train/03.1_hvg-deg-5k/historical/tsg_view/output/runs/

# Authoritative shared identities are tracked; representation vectors remain local.
!/stage2/util/output/
/stage2/util/output/*
!/stage2/util/output/api/
!/stage2/util/output/tables/
!/stage2/util/output/gene-identity/
!/stage2/util/output/gene-identity/**/*.csv
/stage2/util/output/representations/

