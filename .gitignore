*.h5ad
# Root-only: a bare `data/` matched ANY directory named data and silently ignored
# vendored code such as drug_emb_model/KPGT/source/src/data/ (ticket 05).
/data/
datasets/

# Wet-lab validation raw data (result figures + animal-experiment plan) is ignored
# on purpose. It used to be hidden by the broad `*_data/*` rule, which also made
# the tracked `disease_data/` category fragile; that rule is retired (ticket 05).
/wet_data/

# External items (ADR 0030): source/ and local/ stay out of git; provenance
# (script/, author_log.json, manifest.sha256) and item docs must stay tracked.
!/pert_data/*
/pert_data/*/source/
/pert_data/*/local/

# Outputs
output/
outputs/
logs/
*.log
wandb/
lightning_logs/

# OS
.DS_Store
Thumbs.db

# Environment & secrets
.env
.env.*
*.local

# Claude
.claude/

# Local agent tooling & scratch (not committed)
.serena/
.uploads/
.scratch/
tmp/

# Frozen pre-refactor MIRI pipeline snapshots (large regenerable artifacts)
stage1/xpert-fda-miri-v0/

# Per-drug biomni agent JSONs / dossiers (regenerable external-agent output)
stage1/xpert-fda-miri-v1/report/cache/
stage1/xpert-fda-miri-v2/12_drug_survey/drugs/
stage1/xpert-fda-miri-v2/12_drug_survey/reports@20.html

# External items (ADR 0030): source/ and local/ stay out of git; provenance
# (script/, author_log.json, manifest.sha256) and item docs must stay tracked.
# The vendored model clones live under each item's source/ (ticket 04).
/pert_model/*/source/
# Exclude the *contents* of local/ (not the directory itself) so the two
# negations below can re-include small notes; excluding the directory made them
# inert (ticket 05).
/pert_model/*/local/*
# Exceptions: small notes in local/ stay tracked.
!/pert_model/*/local/*.md
!/pert_model/*/local/*.txt

# External items (ADR 0030) — disease_data / drug_emb_model (ticket 05).
# `disease_data` ends in `_data`, which the old broad rule matched; the negation
# keeps the category's item docs, scripts and author logs trackable.
!/disease_data/*
# Only the upstream GEO-derived acquisition tree is external. `local/deg/` is
# small and its tracked DEG JSONs must stay in git (spec §4 omits a local rule).
/disease_data/*/source/
# drug_emb_model is code: only the downloaded feature tensors and pretrained
# weights are large external assets; src/ and scripts/ stay tracked.
/drug_emb_model/*/source/feature_extract/
/drug_emb_model/*/source/models/
# Exclude the *contents* of local/ (not the directory itself) so the two
# negations below can re-include small notes; excluding the directory made them
# inert (same pattern as pert_model above).
/drug_emb_model/*/local/*
# Exceptions: small notes in local/ stay tracked.
!/drug_emb_model/*/local/*.md
!/drug_emb_model/*/local/*.txt

# Downloaded weights/datasets used by Stage 2 setup (not repo artifacts)
/download/

# Stage 2 setup outputs and the biolord venv overlay. Ticket 06 moved the run
# cards one level down into `execution/`; the global `output/` rule excludes the
# directory, so it is re-included first (a negative rule cannot re-include a file
# whose parent directory is excluded), then only the textual evidence — run logs
# and meta.json — stays trackable.
!stage2/01_setup/execution/*/output/
stage2/01_setup/execution/*/output/*
!stage2/01_setup/execution/*/output/*.json
!stage2/01_setup/execution/*/output/*.log
stage2/01_setup/execution/biolord/.venv/

# Stage 2 shared environments: venv trees are local-only (locks are tracked)
stage2/_envs/biolord/
stage2/_envs/cmonge/

# Stage 2 · 02_dataset_corpus: the 14 per-plate pseudobulk `_parts/*.npz` are
# already covered by the global `*.npz` rule; this one rule keeps their scan
# bookkeeping (`_parts/_state/shard_plate.json`) out of git too.
stage2/02_dataset_corpus/execution/_parts/_state/

# Orphaned HG FDA-extension archive (large data/weights, provenance only)
/archived/

# Literature reference PDF archive (large, background reading only)
/reference/

# Phenotype external sources (ADR 0038); scripts and provenance stay tracked.
/pheno_data/*/source/
/pheno_data/*/local/

# Retained old formal generation from the reviewed joint v2 atomic exchange.
# Keep recovery bytes local; track only the canonical formal JSON records.
/stage2/03_modes_tenv/execution/.formal-v2-generation/

# Stage 2 Step 07 frozen membership, comparison and fitted artifact manifests.
!/stage2/07_autoencoder/output/
/stage2/07_autoencoder/output/*
!/stage2/07_autoencoder/output/split.json
!/stage2/07_autoencoder/output/test_seal.json
!/stage2/07_autoencoder/output/test_scores.json
!/stage2/07_autoencoder/output/reconstruction_test.png
!/stage2/07_autoencoder/output/aae_loss.png
!/stage2/07_autoencoder/output/models/
/stage2/07_autoencoder/output/models/*
!/stage2/07_autoencoder/output/models/mean/
/stage2/07_autoencoder/output/models/mean/*
!/stage2/07_autoencoder/output/models/mean/manifest.json
!/stage2/07_autoencoder/output/models/PCA_32/
!/stage2/07_autoencoder/output/models/PCA_128/
!/stage2/07_autoencoder/output/models/PCA_512/
/stage2/07_autoencoder/output/models/PCA_*/*
!/stage2/07_autoencoder/output/models/PCA_*/manifest.json
