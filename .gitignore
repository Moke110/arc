# Root-only: a bare `data/` matched ANY directory named data and silently ignored
# vendored code such as drug_emb_model/KPGT/source/src/data/ (ticket 05).
/data/
datasets/

# Wet-lab validation raw data (result figures + animal-experiment plan) is ignored
# on purpose. It used to be hidden by the broad `*_data/*` rule, which also made
# the tracked `disease_data/` category fragile; that rule is retired (ticket 05).
/wet_data/

# External items (ADR 0030): source/ and local/ stay out of git; provenance
# (script/, author_log.json, manifest.sha256) and item docs must stay tracked.
!/pert_data/*
/pert_data/*/source/
/pert_data/*/local/

# Outputs
output/
outputs/
logs/
*.log
wandb/
lightning_logs/

# OS
.DS_Store
Thumbs.db

# Environment & secrets
.env
.env.*
*.local

# Claude
.claude/

# Local agent tooling & scratch (not committed)
.serena/
.uploads/
.scratch/
tmp/

# Frozen pre-refactor MIRI pipeline snapshots (large regenerable artifacts)
stage1/xpert-fda-miri-v0/

# Per-drug biomni agent JSONs / dossiers (regenerable external-agent output)
stage1/xpert-fda-miri-v1/report/cache/
stage1/xpert-fda-miri-v2/12_drug_survey/drugs/
stage1/xpert-fda-miri-v2/12_drug_survey/reports@20.html

# External items (ADR 0030): source/ and local/ stay out of git; provenance
# (script/, author_log.json, manifest.sha256) and item docs must stay tracked.
# The vendored model clones live under each item's source/ (ticket 04).
/pert_model/*/source/
# Exclude the *contents* of local/ (not the directory itself) so the two
# negations below can re-include small notes; excluding the directory made them
# inert (ticket 05).
/pert_model/*/local/*
# Exceptions: small notes in local/ stay tracked.
!/pert_model/*/local/*.md
!/pert_model/*/local/*.txt

# External items (ADR 0030) — disease_data / drug_emb_model (ticket 05).
# `disease_data` ends in `_data`, which the old broad rule matched; the negation
# keeps the category's item docs, scripts and author logs trackable.
!/disease_data/*
# Only the upstream GEO-derived acquisition tree is external. `local/deg/` is
# small and its tracked DEG JSONs must stay in git (spec §4 omits a local rule).
/disease_data/*/source/
# drug_emb_model is code: only the downloaded feature tensors and pretrained
# weights are large external assets; src/ and scripts/ stay tracked.
/drug_emb_model/*/source/feature_extract/
/drug_emb_model/*/source/models/
# Exclude the *contents* of local/ (not the directory itself) so the two
# negations below can re-include small notes; excluding the directory made them
# inert (same pattern as pert_model above).
/drug_emb_model/*/local/*
# Exceptions: small notes in local/ stay tracked.
!/drug_emb_model/*/local/*.md
!/drug_emb_model/*/local/*.txt

# Downloaded weights/datasets used by Stage 2 setup (not repo artifacts)
/download/

# Orphaned HG FDA-extension archive (large data/weights, provenance only)
/archived/

# Literature reference PDF archive (large, background reading only)
/reference/

# Phenotype external sources (ADR 0038); scripts and provenance stay tracked.
/pheno_data/*/source/
/pheno_data/*/local/

# Independent linked checkouts have their own Git indexes and are not repo content.
/.worktrees/


# Plate-matched training payloads are local, and the public reader is tracked.
!/stage2/03_data_train/output/
/stage2/03_data_train/output/*
!/stage2/03_data_train/output/frozen-folds/
!/stage2/03_data_train/output/frozen-folds/**
!/stage2/03_data_train/output/api/
!/stage2/03_data_train/output/api/*.py

# Source-specific Step 03 publishes manifests and materializes expression locally.
!/stage2/03_data_train/03.*_tenv_*/output/
/stage2/03_data_train/03.*_tenv_*/output/*
!/stage2/03_data_train/03.*_tenv_*/output/manifest.json
/stage2/03_data_train/03.*_tenv_*/.output.previous/
/stage2/03_data_train/03.*_tenv_*/.output.publication.lock
!/stage2/03_data_train/03.2_tahoe_hvg-5k/output/
/stage2/03_data_train/03.2_tahoe_hvg-5k/output/*
!/stage2/03_data_train/03.2_tahoe_hvg-5k/output/api/
!/stage2/03_data_train/03.2_tahoe_hvg-5k/output/api/*.py
!/stage2/03_data_train/03.2_tahoe_hvg-5k/output/release/
/stage2/03_data_train/03.2_tahoe_hvg-5k/output/release/*
!/stage2/03_data_train/03.2_tahoe_hvg-5k/output/release/manifest.json

# Step 04 owns axis training code. Local run payloads stay ignored.
!/stage2/04_tsg_axis/output/
/stage2/04_tsg_axis/output/*
!/stage2/04_tsg_axis/output/api/
!/stage2/04_tsg_axis/output/api/**
/stage2/04_tsg_axis/output/api/**/__pycache__/
!/stage2/04_tsg_axis/figure/canonical-axis/data/delta-metrics.csv
!/stage2/04_tsg_axis/figure/canonical-axis/data/disease-f1.csv
/stage2/04_tsg_axis/log/319-runs/

# Step 05.1 publishes compact score evidence. Checkpoints stay under ignored output/.
!/stage2/05_tsg_loss/05.1_loss_metrics/figure/data/delta-metrics.csv
!/stage2/05_tsg_loss/05.1_loss_metrics/figure/data/epoch-objectives.csv
!/stage2/05_tsg_loss/05.1_loss_metrics/log/bandwidths.csv
!/stage2/05_tsg_loss/05.1_loss_metrics/log/fold-scores.csv
!/stage2/05_tsg_loss/05.1_loss_metrics/log/runs.csv

# HVG-DEG axes and compact selection evidence. Keep candidates local.
!/stage2/02_gene_axis/02.1_hvg-deg/output/
/stage2/02_gene_axis/02.1_hvg-deg/output/*
!/stage2/02_gene_axis/02.1_hvg-deg/output/api/
!/stage2/02_gene_axis/02.1_hvg-deg/output/release/
!/stage2/02_gene_axis/02.1_hvg-deg/output/release/**/*.csv
!/stage2/02_gene_axis/02.1_hvg-deg/figure/data/disease-DEG1000-coverage_bars.csv
/stage2/02_gene_axis/02.1_hvg-deg/execution/checkpoints/

# Authoritative shared identities are tracked; representation vectors remain local.
!/stage2/util/output/
/stage2/util/output/*
!/stage2/util/output/api/
!/stage2/util/output/tables/
!/stage2/util/output/gene-identity/
!/stage2/util/output/gene-identity/**/*.csv
/stage2/util/output/representations/

# Retained local historical view payloads.
/stage2/03_data_train/03.1_hvg-deg-5k/historical/tsg_view/execution/freezes/
/stage2/03_data_train/03.1_hvg-deg-5k/historical/tsg_view/execution/checkpoints/

# Stage 2 local historical handoff (ADR 0087).
/stage2/history/
