# Root-only: a bare `data/` matched ANY directory named data and silently ignored
# vendored code such as drug_emb_model/KPGT/source/src/data/ (ticket 05).
/data/
datasets/

# Wet-lab validation raw data (result figures + animal-experiment plan) is ignored
# on purpose. It used to be hidden by the broad `*_data/*` rule, which also made
# the tracked `disease_data/` category fragile; that rule is retired (ticket 05).
/wet_data/

# External items (ADR 0030): source/ and local/ stay out of git; provenance
# (script/, author_log.json, manifest.sha256) and item docs must stay tracked.
!/pert_data/*
/pert_data/*/source/
/pert_data/*/local/

# Outputs
output/
outputs/
logs/
*.log
wandb/
lightning_logs/

# OS
.DS_Store
Thumbs.db

# Environment & secrets
.env
.env.*
*.local

# Claude
.claude/

# Local agent tooling & scratch (not committed)
.serena/
.uploads/
.scratch/
tmp/

# Frozen pre-refactor MIRI pipeline snapshots (large regenerable artifacts)
stage1/xpert-fda-miri-v0/

# Per-drug biomni agent JSONs / dossiers (regenerable external-agent output)
stage1/xpert-fda-miri-v1/report/cache/
stage1/xpert-fda-miri-v2/12_drug_survey/drugs/
stage1/xpert-fda-miri-v2/12_drug_survey/reports@20.html

# External items (ADR 0030): source/ and local/ stay out of git; provenance
# (script/, author_log.json, manifest.sha256) and item docs must stay tracked.
# The vendored model clones live under each item's source/ (ticket 04).
/pert_model/*/source/
# Exclude the *contents* of local/ (not the directory itself) so the two
# negations below can re-include small notes; excluding the directory made them
# inert (ticket 05).
/pert_model/*/local/*
# Exceptions: small notes in local/ stay tracked.
!/pert_model/*/local/*.md
!/pert_model/*/local/*.txt

# External items (ADR 0030) — disease_data / drug_emb_model (ticket 05).
# `disease_data` ends in `_data`, which the old broad rule matched; the negation
# keeps the category's item docs, scripts and author logs trackable.
!/disease_data/*
# Only the upstream GEO-derived acquisition tree is external. `local/deg/` is
# small and its tracked DEG JSONs must stay in git (spec §4 omits a local rule).
/disease_data/*/source/
# drug_emb_model is code: only the downloaded feature tensors and pretrained
# weights are large external assets; src/ and scripts/ stay tracked.
/drug_emb_model/*/source/feature_extract/
/drug_emb_model/*/source/models/
# Exclude the *contents* of local/ (not the directory itself) so the two
# negations below can re-include small notes; excluding the directory made them
# inert (same pattern as pert_model above).
/drug_emb_model/*/local/*
# Exceptions: small notes in local/ stay tracked.
!/drug_emb_model/*/local/*.md
!/drug_emb_model/*/local/*.txt

# Downloaded weights/datasets used by Stage 2 setup (not repo artifacts)
/download/

# Orphaned HG FDA-extension archive (large data/weights, provenance only)
/archived/

# Literature reference PDF archive (large, background reading only)
/reference/

# Phenotype external sources (ADR 0038); scripts and provenance stay tracked.
/pheno_data/*/source/
/pheno_data/*/local/

# Independent linked checkouts have their own Git indexes and are not repo content.
/.worktrees/

# Bases payloads/checkpoints stay local; required compact evidence is force-added.
# The single public implementation under output/api is code, not payload
# (ADR 0062, ticket #156 decision D1).  Git cannot re-include a path whose parent
# directory is excluded, and the pre-existing `output/` rule excludes this
# directory itself, so the directory is re-included FIRST, its contents excluded,
# then the api subtree re-included.  `script/check_tracked.sh` proves the current
# tree only, not future adds; see the #157 review correction in
# log/156-decisions.md.
!/stage2/01_bases/output/
/stage2/01_bases/output/*
!/stage2/01_bases/output/api/
!/stage2/01_bases/output/api/**
# Re-assert the global bytecode rules inside the re-included api tree: a later
# negation overrides an earlier ignore, so without these `git add -A` would stage
# `output/api/**/__pycache__`.
/stage2/01_bases/output/api/**/__pycache__/
/stage2/01_bases/output/api/**/*.py[cod]

# ADR 0062: disposable build resumption state lives in execution/, never output/.
/stage2/01_bases/execution/checkpoints/

# ADR 0062 report panels: the complete plotted values are tracked next to the
# figure, not stored as payload.
!/stage2/01_bases/figure/data/*.csv

# ADR 0062 audit evidence: the dissolved diagnostic evidence CSVs are tracked
# beside the records that seal them.
!/stage2/01_bases/log/diagnostic/*.csv

# ADR 0062 / #162: test fixtures are the recorded plot values that prove a
# figure is a function of those values, so they are tracked next to their PNGs.
!/stage2/01_bases/execution/tests/fixtures/*.csv

# Single-dose tenv5k successor: public code is tracked, candidates disposable.
!/stage2/02_models_tenv-5k/output/
/stage2/02_models_tenv-5k/output/*
!/stage2/02_models_tenv-5k/output/api/
!/stage2/02_models_tenv-5k/output/api/**
/stage2/02_models_tenv-5k/output/api/**/__pycache__/
/stage2/02_models_tenv-5k/output/api/**/*.py[cod]
/stage2/02_models_tenv-5k/execution/checkpoints/
!/stage2/02_models_tenv-5k/figure/data/*.csv
!/stage2/02_models_tenv-5k/log/frozen-inputs/*.csv

!/stage2/03_tsg_drug_emb/output/
/stage2/03_tsg_drug_emb/output/*
!/stage2/03_tsg_drug_emb/output/api/
!/stage2/03_tsg_drug_emb/output/api/**
/stage2/03_tsg_drug_emb/output/api/**/__pycache__/
/stage2/03_tsg_drug_emb/output/api/**/*.py[cod]
/stage2/03_tsg_drug_emb/execution/checkpoints/
!/stage2/03_tsg_drug_emb/figure/data/*.csv
!/stage2/03_tsg_drug_emb/figure/data/tahoe/*.csv

/stage2/04_tsg_dose/execution/checkpoints/
# Independent all-dose TranSiGen public implementation (ADR0075).
!/stage2/04_tsg_dose/output/
/stage2/04_tsg_dose/output/*
!/stage2/04_tsg_dose/output/api/
!/stage2/04_tsg_dose/output/api/**
/stage2/04_tsg_dose/output/api/**/__pycache__/
/stage2/04_tsg_dose/output/api/**/*.py[cod]
!/stage2/04_tsg_dose/figure/data/*.csv
!/stage2/04_tsg_dose/execution/historical/report_126/data/*.csv

/stage2/05_tsg_width_dose/execution/checkpoints/
!/stage2/05_tsg_width_dose/figure/data/*.csv

/stage2/06_tsg_transfer/execution/checkpoints/
!/stage2/06_tsg_transfer/output/
/stage2/06_tsg_transfer/output/*
!/stage2/06_tsg_transfer/output/api/
!/stage2/06_tsg_transfer/output/api/**
/stage2/06_tsg_transfer/output/api/**/__pycache__/
/stage2/06_tsg_transfer/output/api/**/*.py[cod]
!/stage2/06_tsg_transfer/figure/data/*.csv

# ADR 0082 view-variant study: manifests, parents, splits and CSV summaries are
# tracked evidence; expression payloads, frozen truth/run payloads and build or
# fit state are disposable and stay local to the checkout that produced them.
# The global `output/` rule hides the directory, so re-include it before the
# payload patterns below re-exclude the heavy files.
!/stage2/tsg_view/output/
!/stage2/tsg_view/output/**
/stage2/tsg_view/output/**/*.h5ad
/stage2/tsg_view/output/**/*.npy
/stage2/tsg_view/output/runs/
/stage2/tsg_view/execution/freezes/
/stage2/tsg_view/execution/checkpoints/
